{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for the Sanny64 workspace",
  "license": "ISC",
  "author": "Sanny64",
  "type": "module",
  "scripts": {
    "build": "docker compose --project-directory . --env-file .env -f docker/compose/docker-compose.dev.yml build --no-cache sanny64-backend",
    "restart": "docker compose --project-directory . --env-file .env -f docker/compose/docker-compose.dev.yml up -d --build --force-recreate sanny64-backend",
    "initialize:stack": "docker compose --project-directory . --env-file .env -f docker/compose/docker-compose.dev.yml up -d --build --force-recreate --remove-orphans",
    "start": "docker compose --project-directory . --env-file .env -f docker/compose/docker-compose.dev.yml start",
    "stop": "docker compose --project-directory . --env-file .env -f docker/compose/docker-compose.dev.yml stop",
    "lint": "eslint src auth0 prisma.config.ts monitoring",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:integration:discord": "tsx --test monitoring/tests/integration/discord-webhook.integration.test.ts",
    "test:integration:monitoring": "node ../../tooling/scripts/run-integration.mjs",
    "test:integration:redis": "node ../../tooling/scripts/run-redis-tests.mjs",
    "test:unit": "tsx --test \"src/tests/*.test.ts\"",
    "test": "npm run test:unit && npm run test:integration:monitoring && npm run test:integration:redis && npm run test:integration:discord"
  },
  "dependencies": {
    "@auth0/auth0-fastify-api": "^1.3.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prometheus-io/client": "^0.16.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.11",
    "mariadb": "^3.5.3",
    "nodemailer": "^10.0.13",
    "pino": "^10.4.0",
    "redis": "^6.2.1",
    "tsx": "^4.23.13",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "prisma": "^7.9.1"
  }
}
