# Auth0 Configuration
# For local development testing:
# - Domain: sanny64.auth0.com (must have localhost URLs registered as callback URIs)
# - Client ID: Your OAuth application client ID in Auth0
# - Audience: Auth0 API identifier
VITE_AUTH0_DOMAIN="tenant.location.auth0.com" # must match backend/.env AUTH0_DOMAIN
VITE_AUTH0_CLIENT_ID="client id for single page application from auth0" # must match backend/.env AUTH0_CLIENT_ID
VITE_AUTH0_AUDIENCE="https://api.example.de" # must match backend/.env AUTH0_AUDIENCE

# Backend API URL
# Vite only exposes client-side env vars whose name starts with "VITE_"; the
# app picks between these two at runtime via import.meta.env.DEV.
VITE_PROD_API_URL="https://api.example.de" # must match backend/.env PROD_AUTH0_CALLBACK_URL
VITE_DEV_API_URL="https://localhost:8443" # must match backend/.env DEV_AUTH0_CALLBACK_URL