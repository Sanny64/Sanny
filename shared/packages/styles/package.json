{
  "name": "@sanny/styles",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./globals.css": "./globals.css",
    "./main.css": "./main.css",
    "./auxiliary.css": "./auxiliary.css",
    "./party.css": "./party.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@sanny/i18n": "*",
    "framer-motion": "^12.43.0",
    "js-cookie": "^3.0.8"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm run typecheck"
  }
