# Sanny backend environment template (credentials removed)
#
# Copy the backend entries below into backend/.env and replace placeholder
# values. Keep BOTH DEV_ and PROD_ entries; the backend selects one set from
# NODE_ENV, which must be exactly "development" or "production".
#
# Prisma CLI commands load this file only when prisma.config.ts imports dotenv/config.

########################################
# Environment selection
########################################
NODE_ENV="development" # Auth0 Dashboard > Actions > Library > Link Accounts > Secrets.

########################################
# Database and session store
########################################
DATABASE_URL="mysql://user:secret@server/database"
REDIS_PASSWORD="some random password"

########################################
# Auth0 application
########################################
# The Auth0 tenant domain is not the login frontend host. Set this to the
# tenant/custom-domain hostname configured in Auth0 (without https://).
AUTH0_DOMAIN="tenant.location.auth0.com" # Auth0 Dashboard > Settings > General > Domain; copy to every Post Login Action Secret.
AUTH0_AUDIENCE="https://api.example.de" # Auth0 Dashboard > Applications > APIs > Sanny API > Settings > Identifier.
AUTH0_CLIENT_ID="client id" # Auth0 Dashboard > Applications > Applications > backend OAuth application > Settings > Client ID.
AUTH0_CLIENT_SECRET="client secret" # Auth0 Dashboard > Applications > Applications > backend OAuth application > Settings > Client Secret.
AUTH0_M2M_CLIENT_ID="M2M client id" # Auth0 Dashboard > Applications > Applications > M2M application > Settings > Client ID; copy to Actions as a Secret.
AUTH0_M2M_CLIENT_SECRET="M2M client secret" # Auth0 Dashboard > Applications > Applications > M2M application > Settings > Client Secret; copy to Actions as a Secret.
AUTH0_MGMT_AUDIENCE="https://tenant.location.auth0.com/api/v2/" # Auth0 Dashboard > Applications > APIs > Auth0 Management API > API Audience; copy to Actions as a Secret.

########################################
# OAuth redirects and browser origins
########################################
DEV_AUTH0_CALLBACK_URL="https://localhost:8443/api/v001/auth/callback" # Auth0 Dashboard > Applications > backend OAuth application > Settings > Allowed Callback URLs; also add /api/v001/auth/account-link-proof/callback.
PROD_AUTH0_CALLBACK_URL="https://api.example.de/api/v001/auth/callback" # Auth0 Dashboard > Applications > backend OAuth application > Settings > Allowed Callback URLs; also add /api/v001/auth/account-link-proof/callback.
DEV_AUTH0_SUCCESS_REDIRECT="http://localhost:5173/"
PROD_AUTH0_SUCCESS_REDIRECT="https://example.de/"
DEV_AUTH0_LOGOUT_REDIRECT="http://localhost:5173/" # Auth0 Dashboard > Applications > backend OAuth application > Settings > Allowed Logout URLs.
PROD_AUTH0_LOGOUT_REDIRECT="https://example.de/" # Auth0 Dashboard > Applications > backend OAuth application > Settings > Allowed Logout URLs.
DEV_CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
PROD_CORS_ORIGINS="https://example.de,https://auth.example.de,https://www.example.de"

########################################
# Auth0 token claims and verification (backend)
########################################
AUTH0_EMAIL_CLAIM="https://example.de/email" # Auth0 Dashboard > Actions > Library > roleClaims > Secrets: AUTH0_CLAIM_NAMESPACE must match this URL's namespace.
AUTH0_NAME_CLAIM="https://example.de/name" # Auth0 Dashboard > Actions > Library > roleClaims > Secrets: AUTH0_CLAIM_NAMESPACE must match this URL's namespace.
AUTH0_ROLES_CLAIM="https://example.de/roles" # Auth0 Dashboard > Actions > Library > roleClaims > Secrets: AUTH0_CLAIM_NAMESPACE must match this URL's namespace.
AUTH0_EMAIL_VERIFIED_CLAIM="https://example.de/email_verified" # Auth0 Dashboard > Actions > Library > roleClaims and verifyEmail > Secrets: set this exact claim name.

########################################
# Backend security and operations
########################################
DEV_TRUST_PROXY="false"
PROD_TRUST_PROXY="127.0.0.1" # exact IP/CIDR of the trusted reverse proxy; numeric hop counts are not supported
AUTH0_ROLE_SYNC_ENABLED="false" # When true, Auth0 Dashboard > Applications > APIs > Auth0 Management API > Machine to Machine Applications: authorize required role-management scopes.
AUTH0_ASSIGNABLE_ROLES="user,admin" # Auth0 Dashboard > User Management > Roles: create these exact reviewed role names before enabling synchronization.

########################################
# Account linking
########################################
# Backend redirect target for the AccountLinkingPage.
DEV_ACCOUNT_LINK_FRONTEND_URL="http://localhost:5174/confirm-linking" # Auth0 Dashboard > Actions > linkAccounts > Secrets: DEV_ACCOUNT_LINK_CONFIRMATION_URL must point to this backend's /api/v001/auth/confirm-account-linking endpoint.
PROD_ACCOUNT_LINK_FRONTEND_URL="https://auth.example.de/confirm-linking" # Auth0 Dashboard > Actions > linkAccounts > Secrets: PROD_ACCOUNT_LINK_CONFIRMATION_URL must point to this backend's /api/v001/auth/confirm-account-linking endpoint.
# Shared with the Auth0 linkAccounts Action; use a distinct random value.
ACCOUNT_LINK_PROOF_SECRET="replace-with-a-random-secret"
AUTH0_DATABASE_CONNECTION="your database connection name" # Auth0 Dashboard > Authentication > Database > this connection > Applications: enable it for the backend OAuth application; use its exact connection name.

AUTH0_GLOBAL_BUDGET_PER_MIN=200 
# This is a global (not per-IP/session) guard for Auth0's shared tenant-wide Authentication API quota. 
# Free tier allows 300 req/min across the ENTIRE tenant (all logins combined), so a handful of IPs hitting the callback route can exhaust it and lock out every real user - a per-IP limit cannot catch that.
# This only protects the part we control server-side (the token exchange call in /auth/callback); browser traffic that hits Auth0's hosted pages directly is outside our control and not covered here.

########################################
# Auth0 Action secrets (do NOT put these in backend/.env)
########################################
# Add these independently in Auth0 Dashboard > Actions > Library > Action >
# Secrets. Actions cannot access backend/.env.
#
# All Post Login Actions (except roleClaims):
# AUTH0_DOMAIN, AUTH0_M2M_CLIENT_ID, AUTH0_M2M_CLIENT_SECRET, AUTH0_MGMT_AUDIENCE # Must equal backend values.
#
# linkAccounts Action only:
# NODE_ENV="development" # or "production"; must equal the backend value.
# ACCOUNT_LINK_ALLOWED_PROVIDERS="auth0,google-oauth2" # Auth0 Dashboard > Authentication > Social: enable the Google connection for the backend OAuth application.
# DEV_ACCOUNT_LINK_CONFIRMATION_URL="https://localhost:8443/api/v001/auth/confirm-account-linking" # Auth0 Action redirect target; must be reachable by the browser.
# PROD_ACCOUNT_LINK_CONFIRMATION_URL="https://api.example.de/api/v001/auth/confirm-account-linking" # Auth0 Action redirect target; must be reachable by the browser.
# ACCOUNT_LINK_PROOF_SECRET=<the exact same backend value> # Must exactly match backend/.env.
#
# roleClaims Action only:
# AUTH0_CLAIM_NAMESPACE="https://example.de" # Must equal the namespace portion of AUTH0_EMAIL_CLAIM, AUTH0_NAME_CLAIM, and AUTH0_ROLES_CLAIM.
#
# mfaStepUp Action only:
# MFA_ACR="http://schemas.openid.net/pape/policies/2007/06/multi-factor" # Enable TOTP and/or WebAuthn in Auth0 Dashboard > Security > Multi-factor Auth before deploying it in the Post Login flow.
#
# verifyEmail Action only:
# AUTH0_EMAIL_VERIFIED_CLAIM="https://example.de/email_verified" # Must equal the backend value.
#
# assignDefaultUserRole Action only:
# AUTH0_DEFAULT_ROLE_ID="role_id" # Auth0 Dashboard > User Management > Roles > user > copy the role ID. Its M2M application needs only update:users on the Management API.
#
