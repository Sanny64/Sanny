{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for the Sanny64 workspace",
  "license": "ISC",
  "author": "Sanny64",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "cd docker && docker-compose start && cd ..",
    "stop": "cd docker && docker-compose stop && cd ..",
    "restart": "cd docker && docker-compose up --build -d app && cd ..",
    "build": "cd docker && docker-compose up --build && cd ..",
    "test": "tsx --test \"src/tests/*.test.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@auth0/auth0-fastify-api": "^1.3.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.11",
    "mariadb": "^3.5.3",
    "redis": "^6.2.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2"
  }
}
