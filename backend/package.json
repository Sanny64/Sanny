{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for the Sanny64 workspace",
  "license": "ISC",
  "author": "Sanny64",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "docker compose --project-directory docker --env-file .env start",
    "stop": "docker compose --project-directory docker --env-file .env stop",
    "restart": "docker compose --project-directory docker --env-file .env up -d --build --force-recreate app",
    "build": "docker compose --project-directory docker --env-file .env up --build --force-recreate",
    "test": "tsx --test \"src/tests/*.test.ts\" && npm run test:monitoring",
    "test:monitoring": "node monitoring/tests/run-integration.mjs",
    "test:discord-integration": "tsx --test monitoring/tests/discord-integration.test.ts",
    "test:alert-rules-integration": "npm run test:monitoring",
    "test:redis:integration": "tsx --test src/tests/session-rotation.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@auth0/auth0-fastify-api": "^1.3.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prometheus-io/client": "^0.16.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.11",
    "mariadb": "^3.5.3",
    "nodemailer": "^10.0.13",
    "pino": "^10.4.0",
    "redis": "^6.2.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
