{
  "name": "sanny-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/backend",
    "apps/frontend/*",
    "apps/documentation",
    "shared/packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.3",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.6.2",
    "selfsigned": "^5.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.2.1",
    "vitest": "5.0.3",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "preinstall": "node tooling/scripts/check-runtime.mjs",
    "build:auth": "npm run build -w auth",
    "build:backend": "npm run build -w backend",
    "build:docs:en": "npm run build -w documentation -- --locale en",
    "build:docs:de": "npm run build -w documentation -- --locale de",
    "build:docs": "npm run build -w documentation",
    "build:sanny": "npm run build -w sanny",
    "build:frontend": "npm run build:auth && npm run build:docs && npm run build:sanny",
    "build": "npm run build:backend && npm run build:frontend",
    "serve:docs": "npm run build -w documentation && npm run serve -w documentation",
    "serve:docs:de": "npm run build -w documentation -- --locale de && npm run serve -w documentation",
    "dev:auth": "npm run dev -w auth",
    "dev:docs": "npm run dev -w documentation",
    "dev:docs:de": "npm run dev:de -w documentation",
    "dev:sanny": "npm run dev -w sanny",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:auth": "npm run lint -w auth",
    "lint:backend": "npm run lint -w backend",
    "lint:docs": "npm run lint -w documentation",
    "lint:sanny": "npm run lint -w sanny",
    "lint:shared": "npm run lint -w @sanny/i18n && npm run lint -w @sanny/styles && npm run lint -w @sanny/ui",
    "lint:tooling": "eslint eslint.config.js playwright.config.ts prettier.config.ts tooling/scripts shared/tests apps/frontend/frontend-env.d.ts apps/frontend/vite.config.ts apps/frontend/vitest.config.ts apps/frontend/tests apps/frontend/auth/vite.config.ts apps/frontend/auth/vitest.config.ts apps/frontend/sanny/vite.config.ts apps/frontend/sanny/vitest.config.ts",
    "lint": "npm run lint --workspaces && npm run lint:tooling",
    "typecheck:auth": "npm run typecheck -w auth",
    "typecheck:backend": "npm run typecheck -w backend",
    "typecheck:docs": "npm run typecheck -w documentation",
    "typecheck:sanny": "npm run typecheck -w sanny",
    "typecheck:shared": "npm run typecheck -w @sanny/i18n -w @sanny/styles -w @sanny/ui",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:tooling",
    "check:auth": "npm run check -w auth",
    "check:backend": "npm run check -w backend",
    "check:docs": "npm run check -w documentation",
    "check:sanny": "npm run check -w sanny",
    "check:shared": "npm run check -w @sanny/i18n -w @sanny/styles -w @sanny/ui",
    "check:tooling": "npm run lint:tooling && npm run typecheck:tooling",
    "check:runtime": "node tooling/scripts/check-runtime.mjs",
    "check": "npm run check:runtime && npm run check --workspaces && npm run check:tooling",
    "compare:docs": "node tooling/scripts/warn-docs-translation.mjs",
    "review:docs:translations": "node tooling/scripts/record-doc-translation-review.mjs",
    "initialize:stack": "npm run initialize:stack -w backend",
    "restart:backend": "npm run restart -w backend",
    "start:stack": "npm run start -w backend",
    "stop:stack": "npm run stop -w backend",
    "test:auth": "npm run test -w auth",
    "test:backend": "npm run test -w backend",
    "test:sanny": "npm run test -w sanny",
    "test:components": "npm run test -w @sanny/ui",
    "test:e2e:mocked": "playwright test --config=shared/tests/e2e/playwright.mocked.config.ts",
    "test:e2e:docs": "playwright test --config=shared/tests/e2e/playwright.docs.config.ts",
    "test:e2e:real": "node tooling/scripts/run-test-with-stopwatch.mjs --live-only",
    "test:e2e:429": "node tooling/scripts/run-test-with-stopwatch.mjs --monitoring-only",
    "test:e2e": "node tooling/scripts/run-test-with-stopwatch.mjs --e2e-only",
    "test:visual:linux": "node tooling/scripts/run-test-linux-visual.mjs",
    "test:frontend:contracts": "vitest run --config=apps/frontend/vitest.config.ts",
    "test:tooling": "node --test shared/tests/contracts/config.test.mjs",
    "test:ci": "npm run format:check && npm run check && npm run compare:docs && npm run test:tooling && npm run test:components && npm run test:frontend:contracts && npm run test:auth && npm run test:sanny && npm run test:backend && npm run test:e2e:mocked && npm run test:e2e:docs && npm run build:frontend && npm run test:visual:linux",
    "test": "node tooling/scripts/run-test-with-stopwatch.mjs"
  },
  "overrides": {
    "image-size@<=2.0.2": ">2.0.2",
    "serialize-javascript@<=7.0.3": "7.0.3"
  }
}
