{
  "name": "sanny-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "auth",
    "sanny",
    "shared/packages/*",
    "documentation"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.3",
  "prettier": {
    "endOfLine": "lf"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "start:backend": "npm run start -w backend",
    "stop:backend": "npm run stop -w backend",
    "restart:backend": "npm run restart -w backend",
    "dev:auth": "npm run dev -w auth",
    "dev:sanny": "npm run dev -w sanny",
    "dev:docs": "npm run dev -w documentation",
    "dev:docs-de": "npm run dev:de -w documentation",
    "build:auth": "npm run typecheck:shared && npm run build -w auth",
    "build:sanny": "npm run typecheck:shared && npm run build -w sanny",
    "build:docs": "npm run build -w documentation",
    "build:docs-de": "npm run build -w documentation -- --locale de",
    "build:backend": "npm run build -w backend",
    "serve:docs": "npm run build -w documentation && npm run serve -w documentation",
    "serve:docs-de": "npm run build -w documentation -- --locale de && npm run serve -w documentation",
    "format": "prettier . --write --ignore-path .prettierignore",
    "format:check": "prettier . --check --ignore-path .prettierignore",
    "lint": "npm run lint --workspaces && npm run lint:tooling",
    "lint:auth": "npm run lint -w auth",
    "lint:sanny": "npm run lint -w sanny",
    "lint:docs": "npm run lint -w documentation",
    "lint:shared": "npm run lint -w @sanny/i18n && npm run lint -w @sanny/styles && npm run lint -w @sanny/ui",
    "lint:backend": "npm run lint -w backend",
    "lint:tooling": "eslint eslint.config.js vite.shared.ts playwright*.ts scripts e2e auth/vite.config.ts sanny/vite.config.ts",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:tooling",
    "typecheck:backend": "npm run typecheck -w backend",
    "typecheck:auth": "npm run typecheck -w auth",
    "typecheck:sanny": "npm run typecheck -w sanny",
    "typecheck:docs": "npm run typecheck -w documentation",
    "typecheck:shared": "npm run typecheck -w @sanny/i18n -w @sanny/styles -w @sanny/ui",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "check": "npm run check --workspaces && npm run check:tooling",
    "check:backend": "npm run check -w backend",
    "check:auth": "npm run check -w auth",
    "check:sanny": "npm run check -w sanny",
    "check:docs": "npm run check -w documentation",
    "check:shared": "npm run check -w @sanny/i18n -w @sanny/styles -w @sanny/ui",
    "check:frontend": "npm run check -w auth -w sanny -w @sanny/i18n -w @sanny/styles -w @sanny/ui",
    "check:tooling": "npm run lint:tooling && npm run typecheck:tooling",
    "test:tooling": "node --test scripts/config.test.mjs",
    "test:frontend": "npm run check:frontend && npm run build:auth && npm run build:sanny && npm run test:components && npm run test:e2e:mocked",
    "test:frontend:accessibility": "npm run test:e2e:accessibility:shared && npm run test:e2e:accessibility:auth && npm run test:e2e:accessibility:sanny",
    "test:components": "npm run test -w @sanny/ui",
    "test:backend": "npm run test -w backend",
    "test:backend:redis": "npm run test:integration:redis -w backend",
    "test:e2e:real:chromium": "playwright test --config=playwright.real.config.ts --project=chromium --headed",
    "test:e2e:real:firefox": "playwright test --config=playwright.real.config.ts --project=firefox --headed",
    "test:e2e:real:edge": "playwright test --config=playwright.real.config.ts --project=edge --headed",
    "test:e2e:real": "npm run test:e2e:real:chromium && npm run test:e2e:real:firefox && npm run test:e2e:real:edge",
    "test:e2e:accessibility:shared": "playwright test e2e/mock/accessibility.spec.ts",
    "test:e2e:mocked:chromium": "playwright test e2e/mock --project=chromium --workers=2",
    "test:e2e:mocked:firefox": "playwright test e2e/mock --project=firefox --workers=2",
    "test:e2e:mocked:edge": "playwright test e2e/mock --project=edge --workers=2",
    "test:e2e:accessibility:auth": "playwright test e2e/mock/auth-accessibility.spec.ts",
    "test:e2e:accessibility:sanny": "playwright test e2e/mock/sanny-accessibility.spec.ts",
    "test:e2e:mocked": "npm run test:e2e:mocked:chromium && npm run test:e2e:mocked:firefox && npm run test:e2e:mocked:edge",
    "test:e2e:429-spike": "playwright test e2e/monitoring --config=playwright.monitoring.config.ts --project=chromium",
    "test:integration": "npm run test:e2e:real",
    "test:e2e": "npm run test:e2e:mocked && npm run test:integration",
    "test:gate": "npm run format:check && npm run check && npm run test:tooling && npm run test:backend && npm run test:backend:redis && npm run test:frontend && npm run test:integration",
    "test": "node scripts/run-test-with-stopwatch.mjs"
  },
  "overrides": {
    "image-size@<=2.0.2": ">2.0.2",
    "serialize-javascript@<=7.0.3": "7.0.3"
  }
}
